/PROG  CARTY
/MN
   1:L P[1] 500mm/sec FINE ;
   2:L P[2] 500mm/sec CNT50 ;
/POS
P[1]{
   GP1:
   UF : 1, UT : 1, CONFIG : 'N U T, 0, 0, 0',
   X = 100.000 mm, Y = 200.000 mm, Z = 300.000 mm,
   W = 0.000 deg, P = 0.000 deg, R = 0.000 deg
};
P[2]{
   GP1:
   UF : 1, UT : 1, CONFIG : 'N U T, 0, 0, 0',
   X = 100.000 mm, Y = 300.000 mm, Z = 300.000 mm,
   W = 0.000 deg, P = 0.000 deg, R = 0.000 deg
};
/END
