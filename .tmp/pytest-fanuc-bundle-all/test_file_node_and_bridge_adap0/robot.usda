#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def Xform "Robot"
    {
        def Xform "link1" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            def Cube "shape" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 0.1
            }
        }

        def PhysicsRevoluteJoint "J1"
        {
            rel physics:body1 = </World/Robot/link1>
        }

        def Xform "link2" (
