/PROG  CARTL
/MN
   0:  UFRAME_NUM=4 ;
   0:  UTOOL_NUM=1 ;
   1:L P[1] 500mm/sec FINE ;
   2:L P[2] 500mm/sec CNT50 ;
/POS
P[1]{
   GP1:
   UF : 4, UT : 1, CONFIG : 'N U T, 0, 0, 0',
   X = 2050.000 mm, Y = 0.000 mm, Z = 1905.000 mm,
   W = 0.000 deg, P = 0.000 deg, R = 0.000 deg
};
P[2]{
   GP1:
   UF : 4, UT : 1, CONFIG : 'N U T, 0, 0, 0',
   X = 2000.000 mm, Y = 0.000 mm, Z = 1905.000 mm,
   W = 0.000 deg, P = 0.000 deg, R = 0.000 deg
};
/END
